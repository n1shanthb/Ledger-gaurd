{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/schema.json",
  "context": {
    "$id": "LGA_GuardianPolicyManager",
    "contract": {
      "abi": [
        {
          "name": "setGuardianPolicy",
          "type": "function",
          "stateMutability": "nonpayable",
          "inputs": [
            { "name": "token", "type": "address" },
            { "name": "policyType", "type": "uint8" },
            { "name": "stopLossPrice", "type": "uint256" },
            { "name": "takeProfitPrice", "type": "uint256" },
            { "name": "maxAmount", "type": "uint256" },
            { "name": "maxSlippageBps", "type": "uint256" }
          ],
          "outputs": []
        }
      ],
      "deployments": [
        {
          "chainId": 8453,
          "address": "0xdBf463E260573797Dd1a03B4f45876aad777453b"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Ledger Guardian Agent",
    "info": {
      "legalName": "LGA Guardian Exit Policy Manager",
      "url": "https://github.com/your-org/ledger-guardian-agent",
      "deploymentDate": "2026-09-04"
    },
    "token": {
      "0x4200000000000000000000000000000000000006": {
        "name": "Wrapped Ether",
        "ticker": "WETH",
        "decimals": 18
      },
      "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913": {
        "name": "USD Coin",
        "ticker": "USDC",
        "decimals": 6
      },
      "0x2Ae3F1Ec7F1F5012CFEab0185bfc7aa3cf0DEc22": {
        "name": "Coinbase Wrapped Staked ETH",
        "ticker": "cbETH",
        "decimals": 18
      },
      "0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf": {
        "name": "Coinbase Wrapped BTC",
        "ticker": "cbBTC",
        "decimals": 8
      }
    }
  },
  "display": {
    "formats": {
      "setGuardianPolicy(address,uint8,uint256,uint256,uint256,uint256)": {
        "intent": "Set Guardian Exit Policy",
        "interpolatedIntent": "{policyType} on {token} — floor {stopLossPrice}, target {takeProfitPrice}, max {maxAmount}, slippage {maxSlippageBps}",
        "fields": [
          {
            "path": "token",
            "label": "Protected Asset",
            "format": "addressName",
            "params": { "sources": ["token", "ens"] }
          },
          {
            "path": "policyType",
            "label": "Policy Type",
            "format": "enum",
            "params": {
              "0": "Stop-Loss",
              "1": "Take-Profit",
              "2": "LP Stop-Loss"
            }
          },
          {
            "path": "stopLossPrice",
            "label": "Stop-Loss Floor",
            "format": "amount",
            "params": {
              "decimals": 8,
              "prefix": "$",
              "suffix": " USD"
            }
          },
          {
            "path": "takeProfitPrice",
            "label": "Take-Profit Target",
            "format": "amount",
            "params": {
              "decimals": 8,
              "prefix": "$",
              "suffix": " USD"
            }
          },
          {
            "path": "maxAmount",
            "label": "Max Trade Amount",
            "format": "tokenAmount",
            "params": { "tokenPath": "token" }
          },
          {
            "path": "maxSlippageBps",
            "label": "Max Slippage",
            "format": "percentage",
            "params": { "decimals": 2 }
          }
        ],
        "required": ["token", "policyType", "maxAmount", "maxSlippageBps"]
      },
      "setGuardianPolicy(address,uint256,uint256,uint256)": {
        "intent": "Set Guardian Stop-Loss Policy (v1)",
        "fields": [
          {
            "path": "token",
            "label": "Protected Asset",
            "format": "addressName",
            "params": { "sources": ["token", "ens"] }
          },
          {
            "path": "stopLossPrice",
            "label": "Stop-Loss Floor",
            "format": "amount",
            "params": {
              "decimals": 8,
              "prefix": "$",
              "suffix": " USD"
            }
          },
          {
            "path": "maxAmount",
            "label": "Max Trade Amount",
            "format": "tokenAmount",
            "params": { "tokenPath": "token" }
          },
          {
            "path": "maxSlippageBps",
            "label": "Max Slippage",
            "format": "percentage",
            "params": { "decimals": 2 }
          }
        ],
        "required": ["token", "stopLossPrice", "maxAmount", "maxSlippageBps"]
      }
    }
  }
}
