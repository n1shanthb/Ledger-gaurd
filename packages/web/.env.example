# Decentralized Receipt Graph (Bearer GRAPH_API_KEY / NEXT_PUBLIC_GRAPH_API_KEY)
NEXT_PUBLIC_SUBGRAPH_QUERY_URL=https://gateway.thegraph.com/api/subgraphs/id/GfvNLa3ym7X6bNDNm6oyqvHGgW2anbzTKhEo7cFPjhvz

# Server + client Gateway key (Studio → API Keys). Prefer GRAPH_API_KEY server-only when possible;
# Activity/Agent client fetches need NEXT_PUBLIC_GRAPH_API_KEY for Bearer on gateway.
GRAPH_API_KEY=
NEXT_PUBLIC_GRAPH_API_KEY=

# Quota: pause Messari Compose fan-out while recording (Receipt Graph still works)
# NEXT_PUBLIC_GRAPH_COMPOSE=0
# Activity _meta poll when no pending (ms) — default 180000
# NEXT_PUBLIC_GRAPH_META_POLL_MS=180000
# GRAPH_COMPOSE_CACHE_MS=300000

# Base RPC for Ledger clear-sign broadcast
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Defaults to v2 GPM in UI; override if you redeploy
NEXT_PUBLIC_GUARDIAN_POLICY_MANAGER=0xdBf463E260573797Dd1a03B4f45876aad777453b
NEXT_PUBLIC_SESSION_VALIDATOR=0xf93f56DF8481144F507dFCf30712658202E164e4

# Public keeper (agent chat + payments). Local: http://127.0.0.1:3001
NEXT_PUBLIC_KEEPER_URL=http://127.0.0.1:3001
# Production: https://lga-keeper-production.up.railway.app

# Quota: pause Messari Compose while recording (Receipt Graph still works)
# NEXT_PUBLIC_GRAPH_COMPOSE=0
# Activity _meta when idle (ms); pending always refreshes meta
# NEXT_PUBLIC_GRAPH_META_POLL_MS=180000

# Optional — Ledger partner originToken (enables CAL clear-sign when descriptor is registered)
# NEXT_PUBLIC_LEDGER_ORIGIN_TOKEN=
