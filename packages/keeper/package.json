{
  "name": "@lga/keeper",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "start:env": "node --env-file=.env --import tsx src/index.ts",
    "dev": "node --import tsx --watch src/index.ts",
    "ring:enroll": "node --import tsx src/enroll.ts",
    "ring:export": "node --import tsx src/ringExport.ts",
    "complete-account": "node --import tsx src/completeAccount.ts",
    "pay": "node --import tsx src/pay.ts",
    "pay:quote": "node --import tsx src/pay.ts --quote",
    "pay:on-hit": "node --import tsx src/runPayOnHit.ts"
  },
  "dependencies": {
    "@lga/graph-data": "file:../graph-data",
    "@hashgraph/sdk": "^2.81.0",
    "@x402/core": "^2.25.0",
    "@x402/express": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "@x402/hedera": "^2.25.0",
    "express": "^5.1.0",
    "viem": "^2.37.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  }
