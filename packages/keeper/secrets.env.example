# Plaintext template for Key Ring enroll.
# 1) wallet-cli ring init          (Ledger USB once)
# 2) cp secrets.env.example secrets.env  → fill values
# 3) WALLET_PASS=… npm run ring:enroll
# 4) delete secrets.env — keeper decrypts secrets.env.enc at runtime (no USB)

KEEPER_SESSION_KEY=0xYOUR_KEEPER_SESSION_PRIVATE_KEY
BASE_RPC_URL=https://mainnet.base.org
SUBGRAPH_QUERY_URL=https://api.studio.thegraph.com/query/1758709/ledger-guardian-agent/v0.0.4
GRAPH_API_KEY=
GUARDIAN_POLICY_MANAGER_ADDRESS=0xdBf463E260573797Dd1a03B4f45876aad777453b
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_PAYMENT_AMOUNT=100000
X402_QUOTE_AMOUNT=10000
PYTH_PRICE_SERVICE_URL=https://hermes.pyth.network
# Required for executePolicy VAAs after Aug 2026 Pyth Core upgrade
PYTH_API_KEY=
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PAY_TO=
# OpenRouter — one API key, per-agent models (Phase 2)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_MODEL_COORDINATOR=openai/gpt-4o-mini
OPENROUTER_MODEL_SENTINEL=openai/gpt-4o-mini
OPENROUTER_MODEL_ORACLE=anthropic/claude-sonnet-4
OPENROUTER_MODEL_BROKER=anthropic/claude-sonnet-4
# Optional Hedera HCS audit topic (create once on HashScan / hedera portal)
HCS_TOPIC_ID=
# Base PaymentAuditLog (indexes HCS refs into Receipt Graph)
PAYMENT_AUDIT_LOG=0x689ae72edebbf31c59e79b3cd0926a7bd638f495
