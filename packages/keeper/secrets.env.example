# Plaintext template for Key Ring enroll.
# 1) wallet-cli ring init          (Ledger USB once)
# 2) cp secrets.env.example secrets.env  → fill values
# 3) WALLET_PASS=… npm run ring:enroll
# 4) delete secrets.env — keeper decrypts secrets.env.enc at runtime (no USB)

KEEPER_SESSION_KEY=0xYOUR_KEEPER_SESSION_PRIVATE_KEY
BASE_RPC_URL=https://mainnet.base.org
SUBGRAPH_QUERY_URL=https://api.studio.thegraph.com/query/1758709/ledger-guardian-agent/v0.0.2
GRAPH_API_KEY=
GUARDIAN_POLICY_MANAGER_ADDRESS=0xdBf463E260573797Dd1a03B4f45876aad777453b
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_PAYMENT_AMOUNT=100000
PYTH_PRICE_SERVICE_URL=https://hermes.pyth.network
# Required for executePolicy VAAs after Aug 2026 Pyth Core upgrade
PYTH_API_KEY=
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PAY_TO=
