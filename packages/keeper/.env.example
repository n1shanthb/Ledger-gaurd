# Autopilot off by default — set PAY_ON_HIT=1 only for fill take / video
PAY_ON_HIT=0
# Band watch (Hermes). Record fill: WATCH_MS=5000. Idle: 90000.
WATCH_MS=90000
# Receipt Graph policy list cache (fills still use Hermes vs cached bands)
GRAPH_POLICY_CACHE_MS=300000
